"server.js":'''import express from "express";
import path from "node:path";
import { fileURLToPath } from "node:url";

const app = express();
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PORT = process.env.PORT || 3000;
const API_KEY = process.env.YOUTUBE_API_KEY;

app.use(express.static(path.join(__dirname, "public")));

const topics = [
  "baseball history statistics analytics",
  "chess tactics strategy grandmaster lessons",
  "world history educational",
  "political science government civics educational",
  "philosophy ideas thought experiments",
  "psychology human behavior cognitive biases",
  "mental math shortcuts tricks",
  "Greek Norse Egyptian mythology"
];

const durationSeconds = (iso) => {
  const m = iso.match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);
  return m ? (+(m[1] || 0) * 3600 + +(m[2] || 0) * 60 + +(m[3] || 0)) : 0;
};

app.get("/api/feed", async (_req, res) => {
  if (!API_KEY) return res.status(503).json({error: "YouTube API key is not configured. Set YOUTUBE_API_KEY in your environment."});
  try {
    // One query per interest, with a modest result count to manage API quota.
    const searchResults = await Promise.all(topics.map(async (query) => {
      const searchUrl = new URL("https://www.googleapis.com/youtube/v3/search");
      searchUrl.search = new URLSearchParams({
        key: API_KEY, part: "snippet", type: "video", maxResults: "8",
        videoDuration: "short", order: "relevance", q: query
      }).toString();
      const response = await fetch(searchUrl);
      if (!response.ok) throw new Error(`YouTube search API error (${response.status})`);
      const data = await response.json();
      return (data.items || []).map(item => ({
        id: item.id.videoId, title: item.snippet.title,
        channel: item.snippet.channelTitle, description: item.snippet.description,
        publishedAt: item.snippet.publishedAt, topic: query,
        thumbnail: item.snippet.thumbnails?.high?.url || item.snippet.thumbnails?.medium?.url
      }));
    }));

    const candidates = searchResults.flat().filter(v => v.id);
    const unique = [...new Map(candidates.map(v => [v.id, v])).values()];
    // videos.list accepts up to 50 IDs per request.
    const qualified = [];
    for (let i = 0; i < unique.length; i += 50) {
      const ids = unique.slice(i, i + 50).map(v => v.id).join(",");
      const detailsUrl = new URL("https://www.googleapis.com/youtube/v3/videos");
      detailsUrl.search = new URLSearchParams({key: API_KEY, part: "contentDetails,statistics", id: ids}).toString();
      const response = await fetch(detailsUrl);
      if (!response.ok) throw new Error(`YouTube video details API error (${response.status})`);
      const data = await response.json();
      const byId = new Map(data.items.map(item => [item.id, item]));
      for (const video of unique.slice(i, i + 50)) {
        const detail = byId.get(video.id);
        if (!detail) continue;
        const seconds = durationSeconds(detail.contentDetails.duration);
        if (seconds >= 15 && seconds <= 120) qualified.push({...video, durationSeconds: seconds, views: Number(detail.statistics?.viewCount || 0)});
      }
    }

    // Interleave interest buckets then shuffle within the combined feed.
    for (let i = qualified.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [qualified[i], qualified[j]] = [qualified[j], qualified[i]];
    }
    res.set("Cache-Control", "public, max-age=300");
    res.json({videos: qualified, count: qualified.length});
  } catch (error) {
    console.error(error);
    res.status(502).json({error: error.message || "Could not load YouTube feed."});
  }
});

app.get("*", (_req, res) => res.sendFile(path.join(__dirname, "public", "index.html")));
app.listen(PORT, () => console.log(`EduTok running on http://localhost:${PORT}`));
''',
