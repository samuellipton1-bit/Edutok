"public/app.js":'''const feed = document.querySelector("#feed");
const refreshButton = document.querySelector("#refresh");
let savedIds = new Set(JSON.parse(localStorage.getItem("edutok-saved") || "[]"));

function formatDuration(seconds) {
  const m = Math.floor(seconds / 60), s = seconds % 60;
  return `${m}:${String(s).padStart(2, "0")}`;
}
function escapeHTML(value="") {
  return value.replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));
}
function saveVideo(id, button) {
  if (savedIds.has(id)) savedIds.delete(id); else savedIds.add(id);
  localStorage.setItem("edutok-saved", JSON.stringify([...savedIds]));
  button.textContent = savedIds.has(id) ? "✓ Saved" : "＋ Save";
}
function makeCard(video) {
  const card = document.createElement("article");
  card.className = "video-card";
  const title = escapeHTML(video.title);
  const channel = escapeHTML(video.channel);
  const description = escapeHTML(video.description || "Educational video.");
  card.innerHTML = `
    <div class="player-wrap">
      <iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.id)}?autoplay=0&rel=0&playsinline=1"
        title="${title}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
    <div class="card-info">
      <div class="meta"><span>Curated topic · ${escapeHTML(video.topic)}</span><span class="duration">${formatDuration(video.durationSeconds)}</span></div>
      <h2>${title}</h2>
      <p class="channel">${channel}</p>
      <p class="description">${description}</p>
      <div class="actions">
        <button class="save">${savedIds.has(video.id) ? "✓ Saved" : "＋ Save"}</button>
        <button class="youtube">Open on YouTube ↗</button>
      </div>
    </div>`;
  card.querySelector(".save").addEventListener("click", e => saveVideo(video.id, e.currentTarget));
  card.querySelector(".youtube").addEventListener("click", () => window.open(`https://www.youtube.com/watch?v=${encodeURIComponent(video.id)}`, "_blank", "noopener"));
  return card;
}
async function loadFeed() {
  refreshButton.disabled = true;
  feed.innerHTML = '<div class="state">Finding short educational videos across all your interests…</div>';
  try {
    const response = await fetch("/api/feed");
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || "Feed request failed.");
    if (!data.videos?.length) {
      feed.innerHTML = '<div class="state">No videos between 15 seconds and 2 minutes were found this time. Tap Refresh to try again.</div>';
      return;
    }
    feed.replaceChildren(...data.videos.map(makeCard));
  } catch (error) {
    feed.innerHTML = `<div class="state"><strong>Feed could not load.</strong><p>${escapeHTML(error.message)}</p><p>Check that the server is running and its YouTube API key is configured.</p></div>`;
  } finally { refreshButton.disabled = false; }
}
refreshButton.addEventListener("click", loadFeed);
if ("serviceWorker" in navigator) window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(console.warn));
loadFeed();
''',
